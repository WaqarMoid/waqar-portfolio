# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# PostgreSQL connection string (e.g. from Neon, Supabase, Railway, or Render)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Admin password for the portfolio CMS (blog posts, projects)
ADMIN_PASSWORD=your_strong_password_here

# Session secret (any long random string)
SESSION_SECRET=replace_with_a_long_random_string

# Spotify API credentials
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# Supabase (used for project file storage only)
# Get from: https://app.supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
